{%- comment -%} Generic page (CGV, confidentialité, contact…). Contact form when the page handle contains « contact ». {%- endcomment -%}
<div class="container container--text page-head">
  {% render 'breadcrumbs', current: page.title %}
  <h1 style="margin-top:3rem">{{ page.title }}</h1>
</div>
<div class="container container--text" style="padding-bottom:var(--section)">
  <div class="prose rte">{{ page.content }}</div>
  {%- if page.handle contains 'contact' -%}
    {%- form 'contact', class: 'stack', style: '--stack:1.5rem;margin-top:3rem' -%}
      {%- if form.posted_successfully? -%}<p class="notice" role="status">{{ 'contact.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<p class="notice" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><input id="c-name" type="text" name="contact[name]" placeholder=" " autocomplete="name" value="{{ form.name }}"><label for="c-name">{{ 'contact.name' | t }}</label></div>
      <div class="field"><input id="c-email" type="email" name="contact[email]" placeholder=" " autocomplete="email" required value="{{ form.email }}"><label for="c-email">{{ 'contact.email' | t }}</label></div>
      <div class="field"><input id="c-phone" type="tel" name="contact[phone]" placeholder=" " autocomplete="tel" value="{{ form.phone }}"><label for="c-phone">{{ 'contact.phone' | t }}</label></div>
      <div class="field"><textarea id="c-msg" name="contact[body]" rows="5" placeholder=" " required>{{ form.body }}</textarea><label for="c-msg" style="top:1rem">{{ 'contact.message' | t }}</label></div>
      <button class="btn" type="submit">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Page", "settings": [] }
{% endschema %}
