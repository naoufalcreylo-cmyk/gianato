{%- comment -%}
  Product rail for the homepage.
  Source = « collection » (its order is kept — e.g. Meilleures ventes, sorted by sales).
  Optional filters: only products that are also in « within » (e.g. Business), none from « exclude » (e.g. Bottines),
  at least « min_sizes » sizes in stock, one colourway per model. Ends with a « Voir plus » tile.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign list_name = s.title | append: ' — accueil'
  assign seen = '|'
  assign shown = 0
  assign target = s.cta_url
  if target == blank
    if s.within != blank
      assign target = s.within.url
    else
      assign target = s.collection.url
    endif
  endif
-%}
<section class="section" aria-labelledby="t-{{ section.id }}">
  <div class="container" data-rail>
    <div class="section-head rail-head reveal">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 id="t-{{ section.id }}">{{ s.title }}</h2>
        {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
      </div>
      <div class="rail-head__aside">
        {%- if target != blank -%}<a class="link" href="{{ target }}">{{ s.cta_label }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        <div class="rail-nav"><button type="button" data-rail-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button><button type="button" data-rail-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button></div>
      </div>
    </div>
    <div class="rail" data-list="{{ list_name | escape }}">
      {%- if s.collection != blank -%}
        {%- paginate s.collection.products by 250 -%}
          {%- for product in s.collection.products -%}
            {%- if shown >= s.limit -%}{%- break -%}{%- endif -%}
            {%- unless product.available -%}{%- continue -%}{%- endunless -%}
            {%- liquid
              assign keep = true
              if s.within != blank or s.exclude != blank
                assign in_within = false
                for c in product.collections
                  if s.within != blank and c.id == s.within.id
                    assign in_within = true
                  endif
                  if s.exclude != blank and c.id == s.exclude.id
                    assign keep = false
                  endif
                endfor
                if s.within != blank and in_within == false
                  assign keep = false
                endif
              endif
              if keep and s.min_sizes > 0
                assign in_stock = 0
                for v in product.variants
                  if v.available
                    assign in_stock = in_stock | plus: 1
                  endif
                endfor
                if in_stock < s.min_sizes and product.has_only_default_variant == false
                  assign keep = false
                endif
              endif
            -%}
            {%- unless keep -%}{%- continue -%}{%- endunless -%}
            {%- if s.distinct -%}
              {%- capture model_key -%}{%- if product.metafields.gianato.model != blank -%}{{ product.metafields.gianato.model.value }}{%- else -%}{% render 'color-siblings', product: product, mode: 'model' %}{%- endif -%}{%- endcapture -%}
              {%- assign key = model_key | strip | default: product.handle | prepend: '|' | append: '|' -%}
              {%- if seen contains key -%}{%- continue -%}{%- endif -%}
              {%- assign seen = seen | append: key -%}
            {%- endif -%}
            {% render 'product-card', product: product, list: list_name, index: shown, sizes: '(min-width:1024px) 23vw, (min-width:600px) 42vw, 64vw' %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}
        {%- endpaginate -%}
        {%- if s.more_tile and target != blank -%}
          <a class="card card--more" href="{{ target }}">
            <span class="card--more__inner"><span class="h4">{{ s.more_label }}</span>{% render 'icon', name: 'arrow' %}</span>
          </a>
        {%- endif -%}
      {%- else -%}
        {%- for i in (1..4) -%}<div class="card"><div class="card__media">{{ 'product-1' | placeholder_svg_tag }}</div></div>{%- endfor -%}
      {%- endif -%}
    </div>
    <div class="rail-progress" aria-hidden="true"><span></span></div>
  </div>
</section>

{% schema %}
{
  "name": "Collection en vedette",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "La sélection" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Souliers business" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "collection", "id": "collection", "label": "Collection source (son ordre est conservé)", "info": "Ex. « Meilleures ventes » pour afficher les modèles les plus vendus en premier." },
    { "type": "collection", "id": "within", "label": "Uniquement les produits aussi présents dans", "info": "Ex. « Chaussures Business ». Facultatif." },
    { "type": "collection", "id": "exclude", "label": "Exclure les produits de", "info": "Ex. « Bottes & Bottines ». Facultatif." },
    { "type": "range", "id": "min_sizes", "label": "Pointures en stock minimum", "min": 0, "max": 6, "step": 1, "default": 0, "info": "0 = tous les produits disponibles." },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "distinct", "label": "Une seule couleur par modèle", "default": true },
    { "type": "text", "id": "cta_label", "label": "Lien", "default": "Voir toute la collection" },
    { "type": "url", "id": "cta_url", "label": "Lien (URL, facultatif)" },
    { "type": "checkbox", "id": "more_tile", "label": "Carte « Voir plus » en fin de carrousel", "default": true },
    { "type": "text", "id": "more_label", "label": "Texte de la carte « Voir plus »", "default": "Voir plus de modèles" }
  ],
  "presets": [{ "name": "Collection en vedette" }]
}
{% endschema %}
