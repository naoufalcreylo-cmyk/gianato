{%- comment -%}
  « Vous aimerez aussi » — Shopify product recommendations (related). Loaded asynchronously:
  the empty shell fetches /recommendations/products?section_id=…&product_id=…&limit=… and swaps itself.
{%- endcomment -%}
{%- assign list_name = section.settings.title -%}
<section class="section" data-recommendations="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}" aria-labelledby="t-{{ section.id }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container" data-rail>
      <div class="section-head rail-head">
        <div>{%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2 id="t-{{ section.id }}" class="h3">{{ section.settings.title }}</h2></div>
        <div class="rail-nav"><button type="button" data-rail-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button><button type="button" data-rail-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button></div>
      </div>
      <div class="rail" data-list="{{ list_name | escape }}">
        {%- for p in recommendations.products -%}{% render 'product-card', product: p, list: list_name, index: forloop.index0, sizes: '(min-width:1024px) 23vw, 64vw' %}{%- endfor -%}
      </div>
      <div class="rail-progress" aria-hidden="true"><span></span></div>
    </div>
  {%- endif -%}
</section>
<script>
  (() => {
    const el = document.currentScript.previousElementSibling;
    if (!el || el.querySelector('.rail')) return;
    fetch(el.dataset.recommendations).then(r => r.text()).then(html => {
      const next = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-recommendations]');
      if (next && next.querySelector('.card')) { el.replaceWith(next); window.GianatoUI?.enhance(next); }
    }).catch(() => {});
  })();
</script>

{% schema %}
{
  "name": "Recommandations",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Dans le même esprit" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Vous aimerez aussi" },
    { "type": "select", "id": "intent", "label": "Type", "default": "related", "options": [{ "value": "related", "label": "Produits similaires" }, { "value": "complementary", "label": "Produits complémentaires (Search & Discovery)" }] },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 4, "max": 10, "step": 1, "default": 8 }
  ]
}
{% endschema %}
