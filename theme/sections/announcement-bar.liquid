{%- comment -%}
  Thin service bar. Desktop: messages side by side; mobile: one at a time (theme.js rotates).
  A campaign block can be added during an actual sales period (brand book: two seasons a year, one rate, no countdown).
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="announce" role="region" aria-label="{{ 'header.announcements' | t }}">
    <div class="announce__track">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a class="announce__item{% if forloop.first %} is-active{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
        {%- else -%}
          <span class="announce__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau de service",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte partout au Maroc" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Bandeau de service" }]
}
{% endschema %}
