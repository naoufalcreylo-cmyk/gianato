{%- comment -%}
  Dual use:
  1. Rendered once in layout/theme.liquid → full-width overlay + default state (frequent searches, signatures).
  2. Fetched by assets/search.js from /search/suggest?q=…&section_id=predictive-search → only [data-ps-results] is swapped.
{%- endcomment -%}
{%- capture results -%}
  {%- if predictive_search.performed -%}
    {%- assign products = predictive_search.resources.products -%}
    {%- assign collections = predictive_search.resources.collections -%}
    {%- assign queries = predictive_search.resources.queries -%}
    {%- if products.size == 0 and collections.size == 0 -%}
      <div class="search__empty" style="grid-column:1/-1">
        <p class="h3">{{ 'search.no_results' | t: terms: predictive_search.terms | escape }}</p>
        <p class="muted" style="margin:.75rem 0 1.5rem">{{ 'search.no_results_hint' | t }}</p>
        {%- assign msg = 'search.whatsapp' | t: terms: predictive_search.terms -%}
        <a class="link" href="{% render 'whatsapp-url', message: msg %}" target="_blank" rel="noopener">{{ 'search.ask_advisor' | t }} {% render 'icon', name: 'arrow' %}</a>
      </div>
    {%- else -%}
      <div class="search__col">
        <h3>{{ 'search.collections' | t }}</h3>
        {%- if collections.size > 0 -%}
          <ul class="search__terms" role="list">{%- for c in collections limit: 6 -%}<li><a href="{{ c.url }}"><span>{{ c.title }}</span><span>{{ c.all_products_count }}</span></a></li>{%- endfor -%}</ul>
        {%- else -%}<p class="muted" style="font-size:var(--fs-md)">{{ 'search.no_collection' | t }}</p>{%- endif -%}
        {%- if queries.size > 0 -%}
          <h3 style="margin-top:1.5rem">{{ 'search.suggestions' | t }}</h3>
          <ul class="search__terms" role="list">{%- for q in queries limit: 4 -%}<li><a href="{{ q.url }}"><span>{{ q.styled_text }}</span></a></li>{%- endfor -%}</ul>
        {%- endif -%}
      </div>
      <div class="search__col">
        <h3>{{ 'search.products' | t }}</h3>
        <div class="search__products">
          {%- for p in products limit: 8 -%}
            <a class="search__product" href="{{ p.url }}">
              <div class="media">{% render 'image', image: p.featured_media.preview_image, sizes: '(min-width:1024px) 15vw, 45vw', alt: '', max: 720, class: 'pack' %}</div>
              <p>{{ p.metafields.gianato.model.value | default: p.title }}{% if p.metafields.gianato.colorway != blank %} <span class="muted">— {{ p.metafields.gianato.colorway.value }}</span>{% endif %}<span class="price">{{ p.price | money_without_trailing_zeros }}</span></p>
            </a>
          {%- endfor -%}
        </div>
        <div class="search__foot"><a class="btn btn--ghost" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&type=product">{{ 'search.view_all' | t }} {% render 'icon', name: 'arrow' %}</a></div>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="search__col">
      <h3>{{ 'search.popular' | t }}</h3>
      <ul class="search__terms" role="list">
        {%- for c in section.settings.popular_collections -%}<li><a href="{{ c.url }}"><span>{{ c.title }}</span><span>{{ c.all_products_count }}</span></a></li>{%- endfor -%}
      </ul>
    </div>
    <div class="search__col">
      <h3>{{ section.settings.featured_heading }}</h3>
      <div class="search__products">
        {%- for p in section.settings.featured_products limit: 4 -%}
          <a class="search__product" href="{{ p.url }}">
            <div class="media">{% render 'image', image: p.featured_media.preview_image, sizes: '(min-width:1024px) 15vw, 45vw', alt: '', max: 720, class: 'pack' %}</div>
            <p>{{ p.metafields.gianato.model.value | default: p.title }}<span class="price">{{ p.price | money_without_trailing_zeros }}</span></p>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- if predictive_search.performed -%}
  <div data-ps-results class="search__body">{{ results }}</div>
{%- else -%}
  <div class="layer search" id="search" aria-hidden="true" data-layer data-search>
    <div class="layer__scrim" data-close></div>
    <div class="search__panel" role="dialog" aria-modal="true" aria-label="{{ 'search.title' | t }}">
      <form class="container" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <div class="search__bar">
          {% render 'icon', name: 'search' %}
          <label class="visually-hidden" for="q">{{ 'search.label' | t }}</label>
          <input class="search__input" id="q" name="q" type="search" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="off" aria-controls="search-results" aria-describedby="search-status">
          <button class="icon-btn" type="button" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
        </div>
        <p class="visually-hidden" id="search-status" aria-live="polite"></p>
        <div id="search-results"><div data-ps-results class="search__body">{{ results }}</div></div>
      </form>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Recherche",
  "settings": [
    { "type": "text", "id": "placeholder", "label": "Texte d’exemple", "default": "Mocassin, Monte Cristo, daim…" },
    { "type": "collection_list", "id": "popular_collections", "label": "Recherches fréquentes (collections)", "limit": 8 },
    { "type": "text", "id": "featured_heading", "label": "Titre des produits suggérés", "default": "Les signatures" },
    { "type": "product_list", "id": "featured_products", "label": "Produits suggérés (avant saisie)", "limit": 4 }
  ]
}
{% endschema %}
