<div class="container not-found">
  <div style="max-width:28rem">
    <img src="{{ 'logo-espresso.png' | asset_url }}" alt="{{ shop.name }}" width="1400" height="335" style="width:12rem;margin:0 auto 3rem">
    <p class="lede">{{ shop.password_message | default: section.settings.message }}</p>
    {%- form 'storefront_password', class: 'stack', style: '--stack:1.25rem;margin-top:2.5rem;text-align:left' -%}
      {%- if form.errors -%}<p class="notice" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><input id="sp" type="password" name="password" placeholder=" " autocomplete="current-password" required><label for="sp">{{ 'account.password' | t }}</label></div>
      <button class="btn btn--block" type="submit">{{ 'account.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Mot de passe", "settings": [{ "type": "text", "id": "message", "label": "Message", "default": "La Maison prépare sa nouvelle collection." }] }
{% endschema %}
