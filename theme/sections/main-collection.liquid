{%- comment -%}
  Collection page (PLP). Filters/sort/load-more are swapped through the Section Rendering API by assets/facets.js;
  without JS everything works as plain links and forms. URLs and handles are unchanged (SEO preserved).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign hero = collection.image
  if collection.metafields.gianato.hero != blank
    assign hero = collection.metafields.gianato.hero.value
  endif
  assign intro = collection.metafields.gianato.intro.value | default: collection.description
  assign list_name = collection.title
-%}
<div class="plp-root" data-plp data-section-id="{{ section.id }}">
  <div class="container">
    <header class="plp-head{% if hero == blank or s.show_image == false %} plp-head--plain{% endif %}">
      <div class="plp-head__text">
        {% render 'breadcrumbs', current: collection.title %}
        <div>
          <h1>{{ collection.title }}</h1>
          {%- if intro != blank -%}<div class="rte-intro"><p>{{ intro | strip_html | truncate: 220 }}</p></div>{%- endif -%}
          {%- if s.styles_menu != blank -%}
            <nav class="plp-sub" aria-label="{{ 'collections.styles' | t }}">
              {%- for link in linklists[s.styles_menu].links -%}<a href="{{ link.url }}"{% if link.url == collection.url %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- endfor -%}
            </nav>
          {%- endif -%}
        </div>
      </div>
      {%- if hero != blank and s.show_image -%}
        <div class="plp-head__media"><div class="media">{% render 'image', image: hero, sizes: '28vw', alt: '', eager: true, max: 1200 %}</div></div>
      {%- endif -%}
    </header>
  </div>

  {%- paginate collection.products by s.per_page -%}
    <div class="toolbar"><div class="container toolbar__inner">
      <div class="toolbar__start">
        <button class="ui" type="button" data-filters-toggle aria-expanded="true" aria-controls="filters">{% render 'icon', name: 'filter' %}{{ 'collections.filters' | t }}<span class="count">{% assign active = 0 %}{% for f in collection.filters %}{% assign active = active | plus: f.active_values.size %}{% if f.min_value.value or f.max_value.value %}{% assign active = active | plus: 1 %}{% endif %}{% endfor %}{% if active > 0 %} ({{ active }}){% endif %}</span></button>
        <span class="ui count hide-m" data-plp-count aria-live="polite">{{ 'collections.models_count' | t: count: collection.products_count }}</span>
      </div>
      <div class="toolbar__end">
        <label class="visually-hidden" for="sort">{{ 'collections.sort' | t }}</label>
        <select class="select" id="sort" data-sort>
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{%- endfor -%}
        </select>
        <div class="density" role="group" aria-label="{{ 'collections.density' | t }}">
          <button type="button" data-density="2" aria-pressed="false" aria-label="2"><svg viewBox="0 0 16 16"><rect x="1" y="1" width="6" height="14"/><rect x="9" y="1" width="6" height="14"/></svg></button>
          <button type="button" data-density="3" aria-pressed="true" aria-label="3"><svg viewBox="0 0 16 16"><rect x="0" y="1" width="4" height="14"/><rect x="6" y="1" width="4" height="14"/><rect x="12" y="1" width="4" height="14"/></svg></button>
          <button type="button" data-density="4" aria-pressed="false" aria-label="4"><svg viewBox="0 0 16 16"><rect x="0" y="1" width="3" height="14"/><rect x="4.3" y="1" width="3" height="14"/><rect x="8.6" y="1" width="3" height="14"/><rect x="13" y="1" width="3" height="14"/></svg></button>
        </div>
      </div>
    </div></div>

    <div class="container">
      <div class="chips" data-active-filters aria-label="{{ 'collections.active_filters' | t }}">
        {%- for f in collection.filters -%}
          {%- for v in f.active_values -%}<a class="chip" href="{{ v.url_to_remove }}" data-facet-link>{{ v.label }}{% render 'icon', name: 'close' %}</a>{%- endfor -%}
          {%- if f.min_value.value or f.max_value.value -%}<a class="chip" href="{{ f.url_to_remove }}" data-facet-link>{{ f.min_value.value | default: 0 | money_without_trailing_zeros }} – {{ f.max_value.value | default: f.range_max | money_without_trailing_zeros }}{% render 'icon', name: 'close' %}</a>{%- endif -%}
        {%- endfor -%}
      </div>
      <div class="plp" data-density="3">
        {% render 'facets', results: collection %}
        <div>
          <h2 class="visually-hidden">{{ 'collections.products' | t }}</h2>
          <div class="product-grid" data-plp-grid data-list="{{ list_name | escape }}">
            {%- for product in collection.products -%}
              {%- assign eager = false -%}{%- if forloop.index0 < 3 -%}{%- assign eager = true -%}{%- endif -%}
              {% render 'product-card', product: product, list: list_name, index: forloop.index0, eager: eager %}
            {%- else -%}
              <div class="plp-empty"><p class="h3">{{ 'collections.empty_title' | t }}</p><p>{{ 'collections.empty_text' | t }}</p>
                <div class="empty-state__links"><a class="link" href="{{ collection.url }}" data-facet-link>{{ 'collections.clear' | t }}</a></div></div>
            {%- endfor -%}
          </div>
          <div class="plp-more" data-plp-more>
            {%- assign seen_count = paginate.current_offset | plus: collection.products.size -%}
            {%- if paginate.items > 0 -%}<p class="label muted">{{ 'collections.progress' | t: shown: seen_count, total: paginate.items }}</p>
              <div class="plp-more__bar" aria-hidden="true"><span style="width: {{ seen_count | times: 100 | divided_by: paginate.items }}%"></span></div>{%- endif -%}
            {%- if paginate.next -%}<a class="btn btn--ghost" href="{{ paginate.next.url }}" data-load-more>{{ 'collections.load_more' | t }}</a>{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endpaginate -%}
</div>
<script type="application/ld+json">
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} } ] }
</script>
<script src="{{ 'facets.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Produits par page", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_image", "label": "Image de la collection dans l’en-tête", "default": true },
    { "type": "link_list", "id": "styles_menu", "label": "Navigation par style (menu)" }
  ]
}
{% endschema %}
