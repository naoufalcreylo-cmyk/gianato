{%- comment -%} Service promise — four quiet columns, outline icons, stitched rules. {%- endcomment -%}
<section class="section{% if section.settings.tight %} section--tight-top{% endif %}" aria-label="{{ 'home.services' | t }}">
  <div class="container services">
    {%- for block in section.blocks -%}
      <div class="service reveal" style="--d:{{ forloop.index0 | times: 70 }}ms" {{ block.shopify_attributes }}>
        {% render 'icon', name: block.settings.icon %}
        <h3>{% if block.settings.url != blank %}<a href="{{ block.settings.url }}">{{ block.settings.title }}</a>{% else %}{{ block.settings.title }}{% endif %}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Services",
  "tag": "div",
  "max_blocks": 4,
  "settings": [{ "type": "checkbox", "id": "tight", "label": "Sans marge haute", "default": true }],
  "blocks": [
    { "type": "service", "name": "Service", "settings": [
      { "type": "select", "id": "icon", "label": "Icône", "default": "truck", "options": [
        { "value": "truck", "label": "Livraison" }, { "value": "exchange", "label": "Échange" }, { "value": "lock", "label": "Paiement" },
        { "value": "seal", "label": "Garantie" }, { "value": "phone", "label": "Téléphone" }, { "value": "whatsapp", "label": "WhatsApp" } ] },
      { "type": "text", "id": "title", "label": "Titre", "default": "Livraison offerte" },
      { "type": "textarea", "id": "text", "label": "Texte" },
      { "type": "url", "id": "url", "label": "Lien" }
    ] }
  ],
  "presets": [{
    "name": "Services",
    "blocks": [
      { "type": "service", "settings": { "icon": "truck", "title": "Livraison offerte", "text": "Partout au Maroc, en 2 à 5 jours ouvrés. Express en 24 à 72 h." } },
      { "type": "service", "settings": { "icon": "exchange", "title": "Échange sous 30 jours", "text": "Pointure à revoir ? Nous organisons la collecte, à domicile ou au bureau." } },
      { "type": "service", "settings": { "icon": "lock", "title": "Paiement sécurisé", "text": "En espèces à la livraison, ou par carte via CMI, avec 3D Secure." } },
      { "type": "service", "settings": { "icon": "seal", "title": "Garantie 1 an", "text": "Chaque paire GIANATO est garantie contre les défauts de fabrication." } }
    ]
  }]
}
{% endschema %}
